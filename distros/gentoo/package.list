# ============================================================
# Gentoo 包列表（通过 ROOT= emerge 安装到目标 rootfs；musl profile）
#
# 语法：
#   [pm] <package>                —— emerge 安装（ROOT=${ROOTFS} emerge）
#   [dl@<url>] <binary_name>      —— 下载 URL 到 /usr/local/bin/<binary_name>
#
# 与 alpine 链的包集对齐（同一 VM 服务体系：ntpd/keepalived 等），
# 确保 base/ 的 OpenRC 配置体系（init.d/conf.d/runlevels）两发行版通用。
# tailscale（net-vpn/tailscale，musl 有官方 ebuild）与 cloudflared（静态
# 二进制）均适配 musl。
# ============================================================

# ========== base ==========
[pm] sys-apps/busybox
[pm] sys-apps/baselayout
[pm] acct-group/uucp
[pm] app-shells/bash
[pm] net-misc/openssh
[pm] net-misc/curl
[pm] app-editors/nano
[pm] sys-apps/kmod
[pm] sys-apps/iproute2
[pm] sys-apps/util-linux
[pm] sys-libs/timezone-data
[pm] sys-apps/openrc
[pm] sys-process/procps
[pm] app-misc/fastfetch
[pm] net-dns/dnsmasq
[pm] net-firewall/nftables
# keepalived 运行时依赖 libmagic.so.1（MIME 文件检查），需显式装 file 提供
[pm] sys-apps/file
[pm] sys-cluster/keepalived
[pm] net-vpn/tailscale
[dl@https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64] cloudflared
