# ============================================================
# Alpine Linux 包列表
#
# 语法：
#   [pm] <package>                —— 包管理器安装（apk add）
#   [dl@<url>] <binary_name>      —— 下载 URL 到 /usr/local/bin/<binary_name>
#
# ============================================================

# ========== base ==========
[pm] openssh
[pm] ca-certificates-bundle
[pm] kmod
[pm] iproute2
[pm] tzdata
[pm] busybox-openrc
[pm] dnsmasq
[pm] nftables
[pm] tailscale
[pm] keepalived
[pm] fastfetch
[dl@https://github.com/cloudflare/cloudflared/releases/download/2026.8.3/cloudflared-linux-amd64] cloudflared
