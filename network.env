# ============================
# 路由器网络拓扑配置
# ============================

# ---------- WAN 口 ----------
WAN_IFACE=eth0
WAN_MODE=dhcp                      # dhcp | static | pppoe
# static/pppoe 模式才需要以下
# WAN_IP=192.168.1.100
# WAN_GATEWAY=192.168.1.1
# WAN_DNS1=1.1.1.1
# WAN_DNS2=8.8.8.8

# ---------- LAN 口 ----------
LAN_IFACE=eth1
LAN_IP=192.168.10.1
LAN_NETMASK=255.255.255.0
LAN_CIDR=24
LAN_NETWORK=192.168.10.0/24

# ---------- DHCP 服务器 ----------
DHCP_RANGE_START=192.168.10.100
DHCP_RANGE_END=192.168.10.200
DHCP_LEASE_TIME=12h

# ---------- Tailscale ----------
# 设备名与发行版无关（alpine/gentoo 共用同一身份，避免切换发行版时 tailnet 重名）
TS_HOSTNAME=nixos-microvm-router
# 通告路由：LAN 网段（与 LAN_NETWORK 保持一致）
TS_ADVERTISE_ROUTES=192.168.10.0/24

# ---------- 浮动网关（VRRP） ----------
# DHCP 下发的默认网关 = 浮动 IP（keepalived 主备持有）：
#   正常：yunshu 容器（MASTER，策略分流/透明代理）
#   容器不可用：本 VM（BACKUP）接管，降级为纯直连 NAT
# 修改时同步：base/keepalived/keepalived.conf + yunshu-nix 的 gatewayConfig
LAN_GATEWAY=192.168.10.254
