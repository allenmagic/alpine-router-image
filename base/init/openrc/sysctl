#!/sbin/openrc-run
# 自定义 sysctl 服务（覆盖 Alpine 默认 /etc/init.d/sysctl）：
#   - 用 -e 忽略不存在的键（busybox sysctl 不支持 systemd-sysctl 的 "-" 前缀语法）
#   - 2026-09 裁剪后内核 MODULES=n（bbr/fq/conntrack 全 builtin），
#     不再依赖 modules 服务

description="Configure kernel parameters"

depend() {
    after clock
    before bootmisc logger
    keyword -prefix -systemd-nspawn -vserver
}

start() {
    ebegin "Configuring kernel parameters"
    local f
    for f in /etc/sysctl.d/*.conf; do
        [ -f "$f" ] && sysctl -e -p "$f"
    done
    [ -f /etc/sysctl.conf ] && sysctl -e -p /etc/sysctl.conf
    eend 0
}
