#!/sbin/openrc-run

name=$RC_SVCNAME
description="Cloudflare Tunnel"

command="/usr/local/bin/cloudflared"
command_args="--no-autoupdate --config /etc/cloudflared/config.yml tunnel run"
command_background="yes"
pidfile="/var/run/$name.pid"
output_log="/var/log/$name.log"
error_log="/var/log/$name.log"

depend() {
    need net
    after firewall
    use logger dns
}

start_pre() {
    # 预检：应用安装 + 配置完整（含非空 token）；不满足则跳过，不 crash
    [ -x /usr/local/bin/cloudflared ] || { eerror "cloudflared 未安装"; return 1; }
    if ! grep -qE '^token:[[:space:]]*[^[:space:]]' /etc/cloudflared/config.yml 2>/dev/null; then
        ewarn "未注入 Cloudflared token，跳过启动（等待 alpine-router-deploy 注入）"
        return 1
    fi
}
