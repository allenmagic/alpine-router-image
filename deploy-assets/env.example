# ============================================================
# Alpine Router 部署环境变量模板（仅密钥类数据）
#
# 配置不再经 deploy 部署：全部配置已由 microvm-router-image 仓库的
# CI 烙进镜像，本文件只承载密钥。
#
# 使用方式（在 NAS 宿主机上）：
#   sudo cp env.example /etc/libvirt/alpine-router.env
#   sudo chmod 600 /etc/libvirt/alpine-router.env
#   按下方【占位】标记替换后，运行 alpine-router-deploy
#
# 该文件由部署脚本 scp 上传到 VM（仅部署瞬间存在），
# install.sh 结束后即删除。所有变量均可选（未填则跳过对应功能）。
# ============================================================

# ──【占位·部署前替换】SSH 公钥（支持多个，每行一个） ──────────
# deploy 通道与日常登录依赖它：r3s 出厂 sshd 默认拒绝 root 密码登录，
# 公钥是唯一免密通道。生成后把 .pub 内容填在这里（多个 key 各占一行）：
#   ssh-keygen -t ed25519 -f /etc/libvirt/alpine-router-deploy
#   cat /etc/libvirt/alpine-router-deploy.pub
# SSH_PUBLIC_KEY="ssh-ed25519 AAAA... deploy-key
# ssh-ed25519 BBBB... personal-key"（占位，真机部署前填入）

# ──【占位·部署前替换】Tailscale 认证密钥 ────────────────────
# 一次性认证密钥：https://login.tailscale.com/admin/settings/keys
# 填入后首次部署会自动 tailscale up 并登录（用完可作废该 key）
# TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxxxxxx

# ──【占位·部署前替换】Cloudflared Tunnel Token ──────────────
# Zero Trust → Networks → Tunnels → 对应隧道 → 获取 token
# CLOUDFLARED_TOKEN=eyJhIjoi...
