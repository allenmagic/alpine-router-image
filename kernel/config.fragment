# ============================================================
# 路由 VM 专用内核 config 片段（x86_64 / cloud-hypervisor guest）
#
# 用法：作为 KCONFIG_ALLCONFIG 喂给 `make allnoconfig`——未在此列出的
# 一律为 n，依赖由 Kconfig 自动 select。build.sh 在 olddefconfig 后
# 逐条校验本文件的每一行是否真实生效（片段静默失效 = 不可引导内核）。
#
# 设计原则：
#   1. 引导链全部 builtin（=y），不留 initramfs/modloop 依赖
#      —— Alpine 官方 virt 把 ext4/virtio_blk/virtio_net 全做成 =m，
#         这是现有 assemble.sh「注入 ext4 依赖链 + depmod」的唯一根因
#   2. 只声明本仓库配置实际用到的能力（nftables 规则 / sysctl / 服务）
#   3. 其余子系统（声卡/DRM/USB/无线/SCSI/文件系统…）一概不编
# ============================================================

# ---------- 架构与基础 ----------
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
# EXPERT：一批「省体积」开关（VT / DEVMEM / TTY 等）的 prompt 带
# `if EXPERT` 门控——不开 EXPERT 时这些符号对用户不可设，片段里的
# "is not set" 会被忽略并回落到 Kconfig 的 default y
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PRINTK=y
CONFIG_KALLSYMS=y
# 以下几项是「用户态 ABI」而非可选特性：allnoconfig 会把带 prompt 的
# 符号一律置 n，即使 Kconfig 里写着 default y。不显式声明就会静默丢失，
# 且 verify-config.py 查不出来（它只校验声明过的项）
# FILE_LOCKING：`if EXPERT` + default y。开 EXPERT 解锁了它的 prompt，
# 随后被 allnoconfig 关掉 —— 实测 openrc 启动时 flock 全部
# "Function not implemented"
CONFIG_FILE_LOCKING=y
# SECCOMP：def_bool y 但 prompt 无条件，与 EXPERT 无关，从来就是 n。
# Alpine 的 openssh 编译时带 --with-sandbox=seccomp_filter，缺它
# sshd 每次连接的 privsep 子进程都会被自己的沙箱初始化打死
CONFIG_SECCOMP=y
# BUG：关掉后 BUG()/WARN() 退化为静默 —— 内核数据结构已损坏却不报，
# 换成更难查的后续崩溃
CONFIG_BUG=y
# ADVISE_SYSCALLS：madvise/fadvise 返回 ENOSYS。musl 的 malloc 与 Go
# runtime 都会调 madvise(MADV_DONTNEED/FREE) 归还内存
CONFIG_ADVISE_SYSCALLS=y
# MEMBARRIER / RSEQ：Go runtime 与 glibc 2.35+ 的调度同步原语
# （Gentoo 侧若走 glibc profile 会用到；musl 不用，但成本近零）
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
# CGROUPS：openrc 的 sysfs 服务无条件尝试挂载 cgroup2，缺它每次启动报错
CONFIG_CGROUPS=y

# ---------- 虚拟化客户机 / 引导协议 ----------
# PVH：CH 可直接引导 ELF vmlinux（跳过 bzImage 解压与实模式引导）
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_PVH=y
# ACPI：CH 的优雅关机（ch-remote power-button / shutdown）依赖它
CONFIG_ACPI=y
# X2APIC：CH 的 MADT 用 x2apic 条目声明 vCPU（含 2 核场景）。缺它条目
# 被整体忽略 → 只认到 1 个 CPU（CH v53 实测 "Allowing 1 present CPUs"）
CONFIG_X86_X2APIC=y

# ---------- PCI（CH 只有 virtio-pci，无 MMIO 传输） ----------
CONFIG_PCI=y
CONFIG_PCI_MMCONFIG=y
CONFIG_PCI_MSI=y

# ---------- 串口控制台（ttyS0/115200，故障恢复通道） ----------
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# VT（虚拟终端）关闭：VM 无 VGA/键盘，且 VT 会 select INPUT 连带拉入
# 整个输入子系统；串口控制台走 SERIAL_8250_CONSOLE，与 VT 无关
# CONFIG_VT is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
# PNP：从 ACPI 表拿串口 IRQ。CH 的 DSDT 把 COM1 的 GSI 声明为非常规值，
# 关掉 PNP 时 8250 驱动回落到「经典 IRQ 4」假设 → 中断永不触发 →
# 内核 printk（轮询）正常、用户态 tty 写（中断驱动 TX）永久静默
# （CH v53 + 6.18.48 实测：到 "Run /sbin/init" 后用户态零输出）
CONFIG_SERIAL_8250_PNP=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y

# ---------- virtio（全 builtin：root 盘/网卡在 initramfs 前就绪） ----------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# MMIO 传输 CH 不用，显式关闭（cmdline 设备探测也一并去掉）
# CONFIG_VIRTIO_MMIO is not set

# ---------- 块层 + 根文件系统（ext4 链 builtin，替代 initrd 注入） ----------
CONFIG_BLOCK=y
# BLK_DEV：VIRTIO_BLK 所在的「Block devices」菜单开关，缺它 virtio_blk
# 会被静默丢弃 → 无根盘（verify-config.py 拦下过这一条）
CONFIG_BLK_DEV=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_JBD2=y
CONFIG_FS_MBCACHE=y
CONFIG_CRC16=y
CONFIG_FS_POSIX_ACL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
# BLK_DEV_INITRD：本方案根文件系统直挂 vda、不需要 initramfs，但保留
# 支持只多几 KB —— 它是 ro rootfs 写点失控时「builtin initramfs 叠
# overlay」回退路线（见 docs/refactor-proposal.md §5）的内核侧前提
CONFIG_BLK_DEV_INITRD=y

# ---------- 网络核心 ----------
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_SYSVIPC=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_SYN_COOKIES=y
CONFIG_IPV6=y
CONFIG_RPS=y
CONFIG_XPS=y
CONFIG_INET_DIAG=y
CONFIG_NETLINK_DIAG=y

# ---------- Tailscale：/dev/net/tun（缺失直接 crash） ----------
CONFIG_TUN=y

# ---------- BBR + FQ（80-performance.conf 的 sysctl 默认值） ----------
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCHED=y

# ---------- netfilter / nftables ----------
# conntrack builtin：80-performance.conf 的 nf_conntrack_* sysctl 需要它先在位
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
# INGRESS：flowtable 的 hook ingress 前置依赖（NF_FLOW_TABLE 要求它）
CONFIG_NETFILTER_INGRESS=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_LOG_SYSLOG=y
# 20-inet-filter.nft 的 flowtable f { hook ingress ... }
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
# 规则实际用到的 nft 表达式（全 builtin：不再依赖运行期 modprobe）
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
# 注：NFT_COUNTER 在 6.18 已并入 nf_tables 核心，符号不再存在（勿声明）
# NFT_FIB 是隐藏符号，由 FIB_IPV4/IPV6 select；FIB_INET 要求两者都在
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FLOW_OFFLOAD=y
CONFIG_NFT_HASH=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_TPROXY=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
# 只装 nftables（无 iptables 包）——legacy xtables 整体不编
# CONFIG_NETFILTER_XTABLES is not set

# ---------- 加密（TCP/IPv6/内核自用最小集，由依赖 select 补齐） ----------
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y

# ---------- 时钟与抢占（路由转发场景：低延迟优先，兼顾空闲省电） ----------
CONFIG_HZ_250=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y

# ---------- 内核映像压缩（zstd：比 gzip 更小且解压更快） ----------
CONFIG_KERNEL_ZSTD=y

# ---------- 加固（路由器暴露 WAN，低成本项全开） ----------
# RELOCATABLE 是 KASLR（RANDOMIZE_BASE）的前置依赖
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
# HARDENED_USERCOPY：copy_to/from_user 的边界与 slab 归属检查，
# 拦下大部分堆越界读写。Alpine virt 同样开启，开销可忽略
CONFIG_HARDENED_USERCOPY=y
# /dev/mem、/proc/kcore 等物理内存读写通道关闭
# CONFIG_DEVMEM is not set
# CONFIG_PROC_KCORE is not set

# ---------- 模块支持 ----------
# 保留 MODULES=y：引导链已全 builtin，但 rootfs 侧 openrc `modules`
# 服务与 kmod 仍在（modprobe 对 builtin 项读 modules.builtin 返回成功），
# 关掉需要连带改 base/ 与两条发行版链，收益不抵风险
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---------- RTC ----------
# CH 不模拟 CMOS RTC（Alpine 内核在 CH 下同样读不到），时钟由 kvm-clock
# 提供、chrony 校准。但 qemu 有 mc146818，test/smoke-test.sh 走 qemu：
# 补上驱动可消掉 openrc `hwclock` 的启动报错，避免日后重复排查
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
# RTC_INTF_DEV：创建 /dev/rtcN 字符设备。`default RTC_CLASS` 但 prompt
# 无条件 —— 又一次 allnoconfig 置 n。少了它内核照样打印
# "rtc_cmos 00:05: registered as rtc0"，但 /dev 下无节点，hwclock 仍失败
CONFIG_RTC_INTF_DEV=y

# ---------- 可观测性与长期运行行为 ----------
# 同样是 allnoconfig 关掉的 default y 项，都不是「特性」而是运维前提
# COREDUMP/ELF_CORE：缺它守护进程崩溃只留一行 dmesg，没有 core 可查
CONFIG_COREDUMP=y
CONFIG_ELF_CORE=y
# VM_EVENT_COUNTERS：/proc/vmstat 的数据来源，缺它内存类监控全空
CONFIG_VM_EVENT_COUNTERS=y
# COMPACTION：路由器连跑数周，skb / virtio ring 的高阶分配会因碎片失败；
# 缺内存规整时表现为「还有空闲内存但分配失败」
CONFIG_COMPACTION=y

# ---------- 明确不编（体积与攻击面） ----------
# CONFIG_DEBUG_INFO is not set
# CONFIG_EFI is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_INPUT is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_SQUASHFS is not set
# CONFIG_WIREGUARD is not set
